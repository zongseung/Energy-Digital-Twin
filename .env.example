# Compose: docker compose --env-file .env.example up --build -d
# Empty until the separately developed bridge and SSH tunnel are ready.
BRIDGE_BASE_URL=
BIND_ADDR=127.0.0.1:8090
REDIS_URL=redis://127.0.0.1:6380/0
RUST_LOG=jeju_twin=info
# Exact browser origins, comma-separated. Compose uses these preview defaults if empty.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:18080,http://localhost:18080

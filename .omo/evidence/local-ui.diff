 #grid-layers { margin:0 0 var(--space-4); padding:0 0 var(--space-3); border:0; border-bottom:1px solid var(--border); }
 #grid-layers legend { color:var(--muted); font-size:var(--text-xs); }
 #grid-layers label { margin:0; }
 .legend::before { content:''; display:inline-block; width:var(--space-3); height:var(--space-1); margin-right:var(--space-2); background:currentColor; vertical-align:middle; }
-.transmission { color:var(--transmission); } .hvdc { color:var(--hvdc); } .station { color:var(--station); } .pv { color:var(--pv); }
+.wind { color:#e1e8e5; } .transmission { color:var(--transmission); } .hvdc { color:var(--hvdc); } .station { color:var(--station); } .pv { color:var(--pv); }
 .map-region { background:#728e9a; overflow:hidden; }
 #viewport { position:absolute; inset:0; }
 #viewport canvas { display:block; width:100%; height:100%; touch-action:none; }
